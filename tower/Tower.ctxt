comment14.params=
comment14.target=void\ cover()
comment14.text=\r\n\ Mueve\ cada\ tapa\ junto\ a\ su\ taza\ correspondiente.\r\n
comment15.params=
comment15.target=java.lang.String[][]\ swapToReduce()
